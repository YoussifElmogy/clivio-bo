VITE_API_BASE_URL=http://72.62.179.120/api
VITE_DOCTOR_CLINIC_MODE=derma

# Package tier — set exactly one to true (priority: 10k > 7.5k > 5k). All false = full.
VITE_PACKAGE_5K=true
VITE_PACKAGE_7_5K=true
VITE_PACKAGE_10K=true   

# SMS: when false, bulk SMS is hidden on Patients page
VITE_SMS_PACKAGE=true

# Max branches (omit or empty = unlimited). Set to 1 for single-branch deployments.
VITE_BRANCH_LIMIT=4

# Derma appointment tabs (10k / full tier only): true = show tab, false = hide
VITE_DERMA_APPOINTMENT_SUMMARY_VIEW_ONLY=true
VITE_DERMA_FACE_MAP_VIEW_ONLY=true
VITE_DERMA_BODY_MAP_VIEW_ONLY=true
VITE_DERMA_LASER_PACKAGES_VIEW_ONLY=true
