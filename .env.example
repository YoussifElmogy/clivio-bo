VITE_API_BASE_URL=http://localhost/api
VITE_DOCTOR_CLINIC_MODE=derma

# Package tier — set exactly one to true (priority: 10k > 7.5k > 5k). All false = full / legacy.
# 5k: hides Inventory, Services, Laser in sidebar + blocks URLs; doctor appointment = summary only
# 7.5k: all sidebar items; doctor appointment = summary only (no face/body/laser tabs)
# 10k: all features; derma tabs controlled by VITE_DERMA_* below
VITE_PACKAGE_5K=false
VITE_PACKAGE_7_5K=false
VITE_PACKAGE_10K=false

# SMS: when false, bulk SMS is hidden on Patients page
VITE_SMS_PACKAGE=true

# Max branches (omit or leave empty for unlimited). Example: 1 = single branch only
VITE_BRANCH_LIMIT=

# Derma appointment tabs (10k / full tier only): true = show tab, false = hide
VITE_DERMA_APPOINTMENT_SUMMARY_VIEW_ONLY=true
VITE_DERMA_FACE_MAP_VIEW_ONLY=true
VITE_DERMA_BODY_MAP_VIEW_ONLY=true
VITE_DERMA_LASER_PACKAGES_VIEW_ONLY=true
