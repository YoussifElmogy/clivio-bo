# Jolie client — copy to `.env.jolie` on the Jolie server (or locally for dev).
# Not committed to git. Used by: npm run dev:jolie | build:jolie | preview:jolie
#
# Vite loads `.env` first, then `.env.jolie` overrides matching keys.

VITE_API_BASE_URL=https://jolie-api.example.com/api
VITE_DOCTOR_CLINIC_MODE=derma

# Package tier — set exactly one to true (priority: 10k > 7.5k > 5k)
VITE_PACKAGE_5K=true
VITE_PACKAGE_7_5K=false
VITE_PACKAGE_10K=false

VITE_SMS_PACKAGE=false
VITE_BRANCH_LIMIT=1

# Derma tabs (only apply on 10k / full tier)
VITE_DERMA_APPOINTMENT_SUMMARY_VIEW_ONLY=true
VITE_DERMA_FACE_MAP_VIEW_ONLY=false
VITE_DERMA_BODY_MAP_VIEW_ONLY=false
VITE_DERMA_LASER_PACKAGES_VIEW_ONLY=false
